{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedSegmentObservation",
  "description": "실측 인접 구간 통과시간의 정규화 Parquet 논리 스키마. 새 Collector나 Kafka 토픽을 구현/배포했다는 의미가 아니다.",
  "type": "object",
  "required": ["eventId", "segmentId", "masterVersion", "mappingVersion", "vehicleId", "occurredAt", "observedAt", "enteredAt", "exitedAt", "collectedAt", "validUntil", "weatherBucket", "sampleKind", "quality", "source", "durationSeconds"],
  "properties": {
    "eventId": {"type":"string","minLength":1},
    "segmentId": {"type":"string","pattern":"^(BUS|SUB):[A-Za-z0-9._-]{1,50}(:[A-Za-z0-9._-]{1,50}){2}$"},
    "masterVersion": {"type":"string","minLength":1},
    "mappingVersion": {"type":"string","minLength":1},
    "vehicleId": {"type":"string","minLength":1,"description":"운행일 범위 차량 추적 ID. 모델 feature로 사용하지 않는다."},
    "occurredAt": {"type":"string","format":"date-time","description":"exitedAt과 같은 실제 구간 통과 완료시각, +09:00"},
    "observedAt": {"type":"string","format":"date-time","description":"원천이 통과 완료를 관측·확정한 시각"},
    "enteredAt": {"type":"string","format":"date-time"},
    "exitedAt": {"type":"string","format":"date-time"},
    "collectedAt": {"type":"string","format":"date-time"},
    "validUntil": {"type":"string","format":"date-time"},
    "weatherBucket": {"enum":["DRY","RAIN","SNOW"]},
    "sampleKind": {"const":"ACTUAL_TRAVERSAL"},
    "quality": {"const":"VERIFIED"},
    "source": {"type":"string","minLength":1},
    "durationSeconds": {"type":"number","exclusiveMinimum":0}
  },
  "additionalProperties": false
}
