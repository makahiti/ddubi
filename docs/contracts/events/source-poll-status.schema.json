{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddubi.local/schemas/source-poll-status.schema.json",
  "title": "SourcePollStatus",
  "type": "object",
  "required": ["pollId", "source", "scopeKey", "startedAt", "finishedAt", "status", "completeSnapshot", "pageCount", "rowCount", "contentHash"],
  "properties": {
    "pollId": {"type": "string", "format": "uuid"},
    "source": {"type": "string", "minLength": 1},
    "scopeKey": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["SUCCESS", "PARTIAL", "FAILED", "RATE_LIMITED", "SKIPPED_NON_SERVICE"]},
    "completeSnapshot": {"type": "boolean"},
    "pageCount": {"type": "integer", "minimum": 0},
    "rowCount": {"type": "integer", "minimum": 0},
    "errorCode": {"type": "string", "minLength": 1},
    "nextAllowedAt": {"type": "string", "format": "date-time"},
    "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
