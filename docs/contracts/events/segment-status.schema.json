{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddubi.local/schemas/segment-status.schema.json",
  "title": "SegmentStatus",
  "description": "Spark 구간 판정. 추가 진단 필드는 선택 필드로 하위 호환한다. 정책 임계값·운영 활성화·보관 기간은 담당 검토 후 확정한다.",
  "type": "object",
  "required": [
    "segmentId",
    "status",
    "computedAt",
    "source"
  ],
  "properties": {
    "segmentId": {
      "type": "string",
      "minLength": 9,
      "maxLength": 180,
      "pattern": "^(BUS|SUB):[A-Za-z0-9._-]{1,50}(:[A-Za-z0-9._-]{1,50}){2}$",
      "description": "Backend 공식 정적 ID와 인접성으로 검증한 수도권 구간 ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "normal",
        "slow",
        "delayed",
        "blocked",
        "unknown"
      ],
      "description": "normal 정상 / slow 지연 경미 / delayed 지연 / blocked 통행 불가 / unknown 데이터 없음"
    },
    "delaySeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "평시 대비 추가 소요 시간(초)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "계산 신뢰도. 최근 관측이 없으면 낮아진다"
    },
    "causes": {
      "type": "array",
      "description": "이 상태에 영향을 준 원본 이벤트들",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "eventType"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "computedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "description": "이 시각 이후엔 unknown으로 취급. Redis TTL과 맞춘다"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "계산한 잡 이름 (예: spark.segment-status)"
    },
    "masterVersion": {
      "type": "string",
      "minLength": 1
    },
    "baselineVersion": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "qualityReason": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "동일 평가 결과 재발행 중복 제거용 SHA-256"
    },
    "observedSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "초 단위. 결측 시 필드 생략"
    },
    "baselineSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "초 단위. 결측 시 필드 생략"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "observationCount": {
      "type": "integer",
      "minimum": 1
    },
    "previousStatus": {
      "type": "string",
      "enum": [
        "normal",
        "slow",
        "delayed",
        "blocked",
        "unknown"
      ],
      "description": "직전 성공 발행 결과의 상태, 최초는 생략"
    }
  },
  "additionalProperties": false
}
