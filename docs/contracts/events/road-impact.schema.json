{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoadImpactTrigger",
  "type": "object",
  "required": [
    "segmentId",
    "eventId",
    "computedAt",
    "validUntil",
    "state",
    "masterVersion"
  ],
  "properties": {
    "segmentId": {
      "type": "string",
      "pattern": "^BUS:[A-Za-z0-9._-]{1,50}(:[A-Za-z0-9._-]{1,50}){2}$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "computedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "const": "POTENTIAL_IMPACT"
    },
    "masterVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
