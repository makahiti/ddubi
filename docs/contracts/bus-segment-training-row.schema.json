{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddubi.local/schemas/bus-segment-training-row.schema.json",
  "title": "BusSegmentTrainingRowV1",
  "description": "인접 버스 구간 실제 통과 한 건에 as-of Feature와 검증 Label을 결합한 Gold 논리 스키마",
  "type": "object",
  "required": [
    "sampleId",
    "segmentId",
    "masterVersion",
    "providerNamespace",
    "providerRouteId",
    "vehicleTraceId",
    "fromStopId",
    "toStopId",
    "fromStopSequence",
    "asOf",
    "passageAt",
    "serviceDate",
    "hourSlot",
    "minuteOfHour",
    "dayOfWeek",
    "isWeekend",
    "isHoliday",
    "features",
    "missingFeatures",
    "featureVersion",
    "pipelineVersion",
    "label"
  ],
  "properties": {
    "sampleId": {"type": "string", "minLength": 1, "maxLength": 240},
    "segmentId": {
      "type": "string",
      "pattern": "^BUS:[A-Za-z0-9._-]{1,50}(:[A-Za-z0-9._-]{1,50}){2}$"
    },
    "masterVersion": {"type": "string", "minLength": 1, "maxLength": 100},
    "providerNamespace": {"type": "string", "minLength": 1, "maxLength": 50},
    "providerRouteId": {"type": "string", "minLength": 1, "maxLength": 50},
    "vehicleTraceId": {"type": "string", "minLength": 1, "maxLength": 100},
    "fromStopId": {"type": "string", "minLength": 1, "maxLength": 50},
    "toStopId": {"type": "string", "minLength": 1, "maxLength": 50},
    "fromStopSequence": {"type": "integer", "minimum": 1, "maximum": 10000},
    "asOf": {"type": "string", "format": "date-time"},
    "passageAt": {"type": "string", "format": "date-time"},
    "serviceDate": {"type": "string", "format": "date"},
    "hourSlot": {"type": "integer", "minimum": 0, "maximum": 23},
    "minuteOfHour": {"type": "integer", "minimum": 0, "maximum": 59},
    "dayOfWeek": {"type": "integer", "minimum": 1, "maximum": 7},
    "isWeekend": {"type": "boolean"},
    "isHoliday": {"type": "boolean"},
    "features": {
      "type": "object",
      "required": [
        "busCongestionCode",
        "busOperationStateCode",
        "recentSegmentMedianSeconds",
        "recentSegmentSampleCount",
        "roadSpeedKph",
        "roadTravelSeconds",
        "roadCoverageRatio",
        "accidentCount",
        "closureCount",
        "assemblyCount",
        "protestCount",
        "temperatureC",
        "humidityPercent",
        "precipitationMm",
        "snowDepthCm",
        "windSpeedMps",
        "cityCongestionLevel",
        "areaPopulationMin",
        "areaPopulationMax",
        "nearbyPopulation"
      ],
      "properties": {
        "busCongestionCode": {"type": ["string", "null"]},
        "busOperationStateCode": {"type": ["string", "null"]},
        "recentSegmentMedianSeconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "recentSegmentSampleCount": {"type": ["integer", "null"], "minimum": 0},
        "roadSpeedKph": {"type": ["number", "null"], "minimum": 0},
        "roadTravelSeconds": {"type": ["number", "null"], "minimum": 0},
        "roadCoverageRatio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "accidentCount": {"type": ["integer", "null"], "minimum": 0},
        "closureCount": {"type": ["integer", "null"], "minimum": 0},
        "assemblyCount": {"type": ["integer", "null"], "minimum": 0},
        "protestCount": {"type": ["integer", "null"], "minimum": 0},
        "temperatureC": {"type": ["number", "null"]},
        "humidityPercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "precipitationMm": {"type": ["number", "null"], "minimum": 0},
        "snowDepthCm": {"type": ["number", "null"], "minimum": 0},
        "windSpeedMps": {"type": ["number", "null"], "minimum": 0},
        "cityCongestionLevel": {"type": ["string", "null"]},
        "areaPopulationMin": {"type": ["integer", "null"], "minimum": 0},
        "areaPopulationMax": {"type": ["integer", "null"], "minimum": 0},
        "nearbyPopulation": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "missingFeatures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "featureVersion": {"const": "bus-segment-feature-v1"},
    "pipelineVersion": {"type": "string", "minLength": 1, "maxLength": 100},
    "label": {
      "type": "object",
      "required": [
        "eventId",
        "kind",
        "startedAt",
        "completedAt",
        "availableAt",
        "durationSeconds",
        "source",
        "quality",
        "accuracySeconds"
      ],
      "properties": {
        "eventId": {"type": "string", "minLength": 1, "maxLength": 240},
        "kind": {"const": "ACTUAL_TRAVERSAL"},
        "startedAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": "string", "format": "date-time"},
        "availableAt": {"type": "string", "format": "date-time"},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "source": {"type": "string", "minLength": 1, "maxLength": 100},
        "quality": {"enum": ["VERIFIED", "ESTIMATED"]},
        "accuracySeconds": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
