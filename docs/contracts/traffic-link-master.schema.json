{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Seoul AccInfo traffic link master",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "namespace", "idSystem", "sourceCrs", "sourceDataset", "accInfoLinkIdVerified", "reviewStatus", "version", "evidenceRef", "validFrom", "validUntil", "links"],
  "properties": {
    "schemaVersion": {"const": 1},
    "namespace": {"const": "SEOUL_ACCINFO_LINK"},
    "idSystem": {"const": "SEOUL_TOPIS_ACCINFO_LINK_ID"},
    "sourceCrs": {"const": "EPSG:4326"},
    "sourceDataset": {"const": "OA-13310"},
    "accInfoLinkIdVerified": {"const": true},
    "reviewStatus": {"const": "APPROVED"},
    "version": {"type": "string", "minLength": 1},
    "evidenceRef": {"type": "string", "minLength": 1},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["linkId", "geometry"],
        "properties": {
          "linkId": {"type": "string", "minLength": 1},
          "roadName": {"type": ["string", "null"]},
          "districtName": {"type": ["string", "null"]},
          "startNodeId": {"type": ["string", "null"]},
          "endNodeId": {"type": ["string", "null"]},
          "geometry": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": 126, "maximum": 128},
                {"type": "number", "minimum": 37, "maximum": 38}
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
