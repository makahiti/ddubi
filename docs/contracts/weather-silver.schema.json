{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather-silver.schema.json",
  "title": "WeatherSilverV1",
  "description": "HDFS /ddubi/silver/weather의 논리 행 계약. 실제 저장 형식은 Parquet이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "source",
    "nx",
    "ny",
    "observedAt",
    "collectedAt",
    "temperatureC",
    "humidityPercent",
    "precipitationMm",
    "precipitationTypeCode",
    "windSpeedMps",
    "windDirectionDegree",
    "windEastWestMps",
    "windNorthSouthMps",
    "missingFields",
    "weatherContentHash",
    "silverVersion",
    "eventDate",
    "eventHour"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "source": { "const": "kma.ultra-srt-ncst" },
    "nx": { "type": "integer" },
    "ny": { "type": "integer" },
    "observedAt": { "type": "string", "format": "date-time" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "temperatureC": { "type": ["number", "null"], "minimum": -80, "maximum": 60 },
    "humidityPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "precipitationMm": { "type": ["number", "null"], "minimum": 0, "maximum": 500 },
    "precipitationTypeCode": { "type": ["integer", "null"], "enum": [0, 1, 2, 3, 5, 6, 7, null] },
    "windSpeedMps": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "windDirectionDegree": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
    "windEastWestMps": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
    "windNorthSouthMps": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
    "missingFields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "weatherContentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "silverVersion": { "const": "weather-silver-v1" },
    "eventDate": { "type": "string", "format": "date" },
    "eventHour": { "type": "integer", "minimum": 0, "maximum": 23 }
  }
}
