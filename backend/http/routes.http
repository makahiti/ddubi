### 경로 API 시나리오
#
# 사용법: auth.http 로 로그인해 accessToken 을 @token 에, schedules.http 로 만든 일정 ID 를
#        @scheduleId 에 넣는다.
#
# ⚠️ 조회 API 는 경로를 만들지 않는다. 저장된 것만 보여 준다.
#    경로는 추천 평가가 저장한다 — recommendations.http 의 ② 를 먼저 한 번 호출해야
#    목록에 무언가 나온다. 그 전에는 빈 배열이다(404 가 아니다).

@host = http://localhost:8080/api/v1
@token = 여기에-액세스-토큰
@scheduleId = 1

### ① 경로 검색 — 외부 API 를 직접 호출한다 (저장하지 않는다)
# 좌표만으로 후보를 훑어보는 용도다. 일정과 무관하고 DB 에 남지 않는다.
POST {{host}}/routes/search
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "startLongitude": 127.0276,
  "startLatitude": 37.4979,
  "endLongitude": 127.0364,
  "endLatitude": 37.5006
}

### ② 일정의 후보 경로 목록 — 저장된 것
# 응답에서 볼 것:
#   routeId       ③④ 에 쓴다
#   selected      주 경로. 하나만 true 다
#   rankNo        최신 순위 캐시. 재계산하면 바뀐다
#   modes         [WALK, BUS] 처럼 이동수단 순서. 목록에 아이콘 늘어놓을 근거
#   segmentCount  구간 수
GET {{host}}/schedules/{{scheduleId}}/routes
Authorization: Bearer {{token}}

> {%
    client.test("200 + 배열", function () {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body.data));
        if (response.body.data.length > 0) {
            client.global.set("routeId", response.body.data[0].routeId);
        }
    });
%}

### ③ 경로 상세 — 구간 분해
# 좌표는 없다. 무거워서 ④ 로 뺐다.
GET {{host}}/routes/{{routeId}}
Authorization: Bearer {{token}}

> {%
    client.test("구간이 있고 좌표는 없다", function () {
        client.assert(response.status === 200);
        client.assert(response.body.data.segments.length > 0);
        client.assert(response.body.data.segments[0].coordinates === undefined);
    });
%}

### ④ 경로 지도 좌표
# segments[].coordinates 가 폴리라인이다. 구간마다 나눠 주므로 도보는 점선,
# 버스는 실선처럼 mode 별로 다르게 그릴 수 있다.
# bounds 로 지도 초기 화면을 맞춘다. 좌표가 하나도 없으면 bounds 는 null 이다.
GET {{host}}/routes/{{routeId}}/map
Authorization: Bearer {{token}}

> {%
    client.test("좌표 배열이 온다", function () {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body.data.segments[0].coordinates));
    });
%}

### ⑤ 아직 평가 안 한 일정 — 빈 배열. 404 가 아니다
# "없는 일정" 과 "아직 계산 전" 은 다른 상황이라 구분해야 한다.
# schedules.http 로 새 일정을 만들고 그 ID 를 넣어 확인한다.
GET {{host}}/schedules/9999/routes
Authorization: Bearer {{token}}

### ⑥ 없는 경로 — 404
GET {{host}}/routes/999999
Authorization: Bearer {{token}}

> {%
    client.test("404", function () {
        client.assert(response.status === 404);
    });
%}

### ⑦ 남의 경로 — 403
# 다른 계정으로 로그인해 받은 토큰으로 ③ 을 그대로 호출한다.
# routeId 는 순번이라 찍어 볼 수 있으므로 반드시 막혀야 한다.
GET {{host}}/routes/{{routeId}}
Authorization: Bearer 다른_계정_토큰

### ⑧ 토큰 없이 — 401
GET {{host}}/routes/{{routeId}}
