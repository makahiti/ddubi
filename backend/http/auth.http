### ⑮ 로그아웃 뒤 재발급 시도 — 401
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("401 — 세션이 지워졌다", function () {
        client.assert(response.status === 401);
