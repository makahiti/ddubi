### 인증 API 시나리오 테스트 (AUTH-001~005)
#
# IntelliJ 에서 이 파일을 열고 각 요청 왼쪽의 ▶ 를 누르면 실행된다.
# 위에서 아래로 순서대로 실행하면 토큰이 자동으로 이어진다.
#
# 사전 준비
#   1) docker compose -f backend/docker-compose.dev.yml up -d
#   2) 앱 기동 (IntelliJ 실행 또는 backend 에서 ./mvnw spring-boot:run)
#
# curl 로 하지 않는 이유: Windows 터미널이 한글을 CP949 로 보내
# "Invalid UTF-8 start byte" 400 이 난다. 이 파일은 UTF-8 로 저장되어 문제없다.

@host = http://localhost:8080
@email = test@ddubi.com
@password = password123
@deviceId = device-A

### ① 회원가입 — 201, provider "LOCAL"
POST {{host}}/api/v1/auth/local/signup
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "nickname": "정민",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("201 이어야 한다", function () {
        client.assert(response.status === 201, "status=" + response.status);
    });
    client.test("공통 응답 형식", function () {
        client.assert(response.body.success === true);
        client.assert(response.body.requestId != null, "requestId 없음");
        client.assert(response.body.timestamp != null, "timestamp 없음");
    });
    client.test("한글이 깨지지 않는다", function () {
        client.assert(response.body.data.user.nickname === "정민",
            "nickname=" + response.body.data.user.nickname);
    });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

### ② 같은 이메일로 다시 가입 — 409 DUPLICATE_RESOURCE
POST {{host}}/api/v1/auth/local/signup
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "nickname": "정민",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("409 이어야 한다", function () {
        client.assert(response.status === 409, "status=" + response.status);
        client.assert(response.body.error.code === "DUPLICATE_RESOURCE");
    });
%}

### ③ 검증 실패 — 400, fieldErrors 에 필드별 사유
POST {{host}}/api/v1/auth/local/signup
Content-Type: application/json

{
  "email": "notanemail",
  "password": "short",
  "nickname": ""
}

> {%
    client.test("400 + fieldErrors", function () {
        client.assert(response.status === 400);
        client.assert(response.body.error.fieldErrors.length > 0, "fieldErrors 비어 있음");
    });
%}

### ④ 로그인 — 200
POST {{host}}/api/v1/auth/local/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("200", function () { client.assert(response.status === 200); });
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

### ⑤ 비밀번호 오류 — 401
POST {{host}}/api/v1/auth/local/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrongpassword",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("401", function () {
        client.assert(response.status === 401);
        client.assert(response.body.error.code === "UNAUTHORIZED");
    });
%}

### ⑥ 토큰 없이 보호 경로 — 401
POST {{host}}/api/v1/routes/search
Content-Type: application/json

{
  "startLongitude": 127.0276, "startLatitude": 37.4979,
  "endLongitude": 126.9779, "endLatitude": 37.5665
}

> {%
    client.test("401", function () { client.assert(response.status === 401); });
%}

### ⑦ Access 토큰으로 보호 경로 — 401 이 아니어야 한다
# KAKAO_REST_API_KEY 가 없으면 503 이 정상이다. 503 이면 인증은 통과한 것.
POST {{host}}/api/v1/routes/search
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "startLongitude": 127.0276, "startLatitude": 37.4979,
  "endLongitude": 126.9779, "endLatitude": 37.5665
}

> {%
    client.test("인증 통과 (401 아님)", function () {
        client.assert(response.status !== 401, "인증이 안 됨");
    });
%}

### ⑧ Refresh 토큰을 Access 자리에 — 401 (용도 분리)
POST {{host}}/api/v1/routes/search
Content-Type: application/json
Authorization: Bearer {{refreshToken}}

{
  "startLongitude": 127.0276, "startLatitude": 37.4979,
  "endLongitude": 126.9779, "endLatitude": 37.5665
}

> {%
    client.test("401 — Refresh 로는 API 를 못 부른다", function () {
        client.assert(response.status === 401, "status=" + response.status);
    });
%}

### ⑨ 토큰 재발급 — 200, refreshToken 이 교체된다
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("200", function () { client.assert(response.status === 200); });
    client.test("토큰이 회전됐다", function () {
        client.assert(response.body.data.refreshToken !== client.global.get("refreshToken"),
            "refreshToken 이 그대로다");
    });
    // 옛 토큰을 따로 남겨 ⑩ 에서 재사용을 시도한다
    client.global.set("oldRefreshToken", client.global.get("refreshToken"));
    client.global.set("refreshToken", response.body.data.refreshToken);
    client.global.set("accessToken", response.body.data.accessToken);
%}

### ⑩ 옛 refreshToken 재사용 — 401 + 전 기기 세션 폐기
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{oldRefreshToken}}",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("401 — 재사용 감지", function () {
        client.assert(response.status === 401, "status=" + response.status);
    });
%}

### ⑪ 폐기 뒤에는 방금 받은 새 토큰도 무효 — 401
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("401 — 세션이 전부 지워졌다", function () {
        client.assert(response.status === 401, "status=" + response.status);
    });
%}

### ⑫ 재로그인 (로그아웃 테스트용 토큰 재확보)
POST {{host}}/api/v1/auth/local/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "deviceId": "{{deviceId}}"
}

> {%
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

