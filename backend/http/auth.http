%}

### 카카오 소셜 로그인 — KAKAO_REST_API_KEY 와 실제 인가 코드가 있어야 동작
# authorizationCode 는 브라우저에서 카카오 로그인을 해야 나오는 1회용 값이다.
# redirectUri 는 그 코드를 발급받을 때 쓴 값과 정확히 같아야 한다.
POST {{host}}/api/v1/auth/oauth
Content-Type: application/json

{
  "provider": "KAKAO",
  "authorizationCode": "BYfZT5vnufhNKOJgUVJXXHekIpEhhZWwG6EuTUuIZRf6oW8ShLFaMwAAAAQKFyIgAAABoFqq5FfgLMgnBn6ZSw",
  "redirectUri": "http://localhost:3001/oauth/kakao",
  "deviceId": "{{deviceId}}"
}

### 카카오 모바일 SDK 로그인 — KAKAO_APP_ID와 실제 액세스 토큰이 있어야 동작
# Flutter 카카오 SDK가 발급한 accessToken을 전달한다.
# 백엔드는 /v1/user/access_token_info의 app_id를 KAKAO_APP_ID와 비교한 뒤 사용자 정보를 조회한다.
POST {{host}}/api/v1/auth/oauth/token
Content-Type: application/json

{
  "provider": "KAKAO",
  "accessToken": "여기에-카카오-모바일-액세스-토큰",
  "deviceId": "{{deviceId}}"
}

### Google 모바일 SDK 로그인 — GOOGLE_CLIENT_ID와 실제 ID 토큰 필요
POST {{host}}/api/v1/auth/oauth/id-token
Content-Type: application/json

{
  "provider": "GOOGLE",
  "idToken": "여기에-Google-ID-토큰",
  "deviceId": "{{deviceId}}"
}

### 구글 소셜 로그인 — GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET 필요
# ⚠️ 콜백 URL 에서 code= 값만 잘라 쓴다. 뒤에 붙은 &scope=... &authuser=... 를 함께
#    넣으면 제공자가 거절한다.
# ⚠️ %2F 같은 URL 인코딩은 풀어서 넣는다(%2F → /). 그대로 두면 한 번 더 인코딩돼 깨진다.
#    예) ...?code=4%2F0ATsMZq...&scope=email  →  4/0ATsMZq...
# 인가 URL (브라우저에서 열어 code 를 받는다):
#   https://accounts.google.com/o/oauth2/v2/auth
#     ?client_id={GOOGLE_CLIENT_ID}
#     &redirect_uri=http://localhost:3001/oauth/google
#     &response_type=code&scope=openid%20email%20profile
POST {{host}}/api/v1/auth/oauth
Content-Type: application/json

{
  "provider": "GOOGLE",
  "authorizationCode": "여기에-구글-인가코드",
  "redirectUri": "http://localhost:3001/oauth/google",
  "deviceId": "{{deviceId}}"
}

### 네이버 소셜 로그인 — NAVER_CLIENT_ID / NAVER_CLIENT_SECRET 필요
# ⚠️ code= 값만 자른다. 뒤의 &state=... 를 code 에 붙이지 말 것.
# ⚠️ state 는 별도 필드에 넣되, 인가 URL 에 쓴 값과 같아야 한다.
#    네이버는 실패해도 코드가 소진되므로 틀리면 인가 URL 부터 다시 받아야 한다.
# 인가 URL:
#   https://nid.naver.com/oauth2.0/authorize
#     ?client_id={NAVER_CLIENT_ID}
#     &redirect_uri=http://localhost:3001/oauth/naver
#     &response_type=code&state=ddubi-test-state
POST {{host}}/api/v1/auth/oauth
Content-Type: application/json

{
  "provider": "NAVER",
  "authorizationCode": "여기에-네이버-인가코드",
  "redirectUri": "http://localhost:3001/oauth/naver",
  "state": "ddubi-test-state",
  "deviceId": "{{deviceId}}"
}

### 네이버인데 state 를 빼면 — 400 INVALID_REQUEST
POST {{host}}/api/v1/auth/oauth
Content-Type: application/json

{
  "provider": "NAVER",
  "authorizationCode": "dummy",
  "redirectUri": "http://localhost:3001/oauth/naver",
  "deviceId": "{{deviceId}}"
}

> {%
    client.test("400 — state 없이는 네이버를 호출조차 하지 않는다", function () {
        client.assert(response.status === 400);
    });
%}

### 지원하지 않는 provider — 400 (ENUM 밖의 값)
POST {{host}}/api/v1/auth/oauth
Content-Type: application/json

{
  "provider": "APPLE",
  "authorizationCode": "dummy",
  "redirectUri": "http://localhost:3001/oauth/apple"
}

> {%
    client.test("400 — ENUM 에 없는 값", function () {
        client.assert(response.status === 400);
    });
%}

###############################################################################
# 이메일 인증 (AUTH-006 / AUTH-007) — 로컬 가입의 선행 단계
#
# MAIL_USERNAME/MAIL_PASSWORD 가 비어 있으면 메일을 보내지 않고
# 서버 콘솔에 코드를 찍는다. 거기서 6자리를 복사해 @verifyCode 에 넣는다.
###############################################################################

@newEmail = newbie@ddubi.com
@verifyCode = 000000

### ㉮ 인증 없이 가입 시도 — 400
POST {{host}}/api/v1/auth/local/signup
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "password": "password123",
  "nickname": "신입"
}

> {%
    client.test("400 — 이메일 인증이 먼저다", function () {
        client.assert(response.status === 400);
        client.assert(response.body.error.message.includes("이메일 인증"));
    });
%}

### ㉯ 인증 코드 발송 — 204 (콘솔 로그에서 코드 확인)
POST {{host}}/api/v1/auth/email/verification
Content-Type: application/json

{
  "email": "{{newEmail}}"
}

> {%
    client.test("204", function () {
        client.assert(response.status === 204);
    });
%}

### ㉰ 60초 안에 재발송 — 400 (도배 차단)
POST {{host}}/api/v1/auth/email/verification
Content-Type: application/json

{
  "email": "{{newEmail}}"
}

> {%
    client.test("400 — 쿨다운", function () {
        client.assert(response.status === 400);
    });
%}

### ㉱ 틀린 코드 — 400, 남은 시도 횟수를 알려준다
POST {{host}}/api/v1/auth/email/verification/confirm
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "code": "999999"
}

> {%
    client.test("400 — 시도 횟수 표시", function () {
        client.assert(response.status === 400);
    });
%}

### ㉲ 형식 오류 (6자리 아님) — 400 fieldErrors
POST {{host}}/api/v1/auth/email/verification/confirm
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "code": "12"
}

> {%
    client.test("400 — fieldErrors 에 code", function () {
        client.assert(response.status === 400);
        client.assert(response.body.error.fieldErrors.length > 0);
    });
%}

### ㉳ 맞는 코드 — 204 (@verifyCode 를 콘솔 값으로 바꾼 뒤 실행)
POST {{host}}/api/v1/auth/email/verification/confirm
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "code": "{{verifyCode}}"
}

> {%
    client.test("204 — 인증 완료", function () {
        client.assert(response.status === 204);
    });
%}

### ㉴ 가입 — 201
POST {{host}}/api/v1/auth/local/signup
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "password": "password123",
  "nickname": "신입"
}

> {%
    client.test("201", function () {
        client.assert(response.status === 201);
    });
%}

### ㉵ 같은 인증으로 또 가입 — 400 (통행증은 1회용)
POST {{host}}/api/v1/auth/local/signup
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "password": "password123",
  "nickname": "신입2"
}

> {%
    client.test("400 — 통행증이 소비됐다", function () {
        client.assert(response.status === 400);
    });
%}

###############################################################################
# 계정 연동 (AUTH-003b, 2026-09-10)
#
# 소셜 이메일이 기존 계정과 같아도 자동으로 붙지 않는다. 아래 순서로 확인한다.
# 자세한 계약: docs/contracts/api-spec-account-link-amendment.md
###############################################################################

### ⑴ 로컬로 먼저 가입해 둔다 — 붙일 대상 계정
# (이메일 인증 코드 발송·확인은 위쪽 시나리오 참고)
POST {{host}}/api/v1/auth/local/signup
Content-Type: application/json

{
  "email": "link-test@ddubi.com",
  "password": "password123",
  "nickname": "기존사용자",
  "deviceId": "dev-link"
}

### ⑵ 같은 이메일의 소셜로 로그인 — ACCOUNT_LINK_REQUIRED 가 나와야 한다
# 응답 data.status 를 확인한다. AUTHENTICATED 가 나오면 자동 통합이 되살아난 것이다.
#
# 기대:
#   "status": "ACCOUNT_LINK_REQUIRED"
#   "linkToken": "..."            ← ⑶ 에 넣는다
#   "email": "li***@ddubi.com"    ← 마스킹
#   "tokens": 없음
POST {{host}}/api/v1/auth/oauth/token
Content-Type: application/json

{
  "provider": "NAVER",
  "accessToken": "네이버_SDK_액세스토큰",
  "deviceId": "dev-link"
}

### ⑶ 비밀번호를 틀리게 — 401, 그리고 티켓이 소비된다
@linkToken = ⑵_응답의_linkToken
POST {{host}}/api/v1/auth/oauth/link
Content-Type: application/json

{ "linkToken": "{{linkToken}}", "password": "wrong-password", "deviceId": "dev-link" }

### ⑷ 같은 티켓으로 맞는 비밀번호 — 401 LINK_TOKEN_INVALID
# ⑶ 에서 이미 소비됐다. 통하면 이 화면이 비밀번호 대입 창구가 된다.
POST {{host}}/api/v1/auth/oauth/link
Content-Type: application/json

{ "linkToken": "{{linkToken}}", "password": "password123", "deviceId": "dev-link" }

### ⑸ ⑵ 를 다시 불러 새 티켓을 받은 뒤 — 연동 성공, 토큰 발급
@freshLinkToken = 다시_받은_linkToken
POST {{host}}/api/v1/auth/oauth/link
Content-Type: application/json

{ "linkToken": "{{freshLinkToken}}", "password": "password123", "deviceId": "dev-link" }

### ⑹ 연동 후 같은 소셜로 로그인 — 이제 바로 AUTHENTICATED
POST {{host}}/api/v1/auth/oauth/token
Content-Type: application/json

{
  "provider": "NAVER",
  "accessToken": "네이버_SDK_액세스토큰",
  "deviceId": "dev-link"
}

### ⑺ 비밀번호 없는 계정에 다른 소셜 — 409 ACCOUNT_LINK_UNAVAILABLE
# 준비: 로컬 가입 없이 구글로만 가입한 계정을 만든 뒤, 같은 이메일로 카카오 로그인.
# 메시지에 실제로 붙어 있는 제공자 이름(GOOGLE)이 들어가야 한다.
POST {{host}}/api/v1/auth/oauth/token
Content-Type: application/json

{
  "provider": "KAKAO",
  "accessToken": "카카오_SDK_액세스토큰",
  "deviceId": "dev-link2"
}

### ⑻ 마이페이지 소셜 연결 — 로그인 상태에서, 비밀번호 없이
# ⑺ 에서 409 ACCOUNT_LINK_UNAVAILABLE 을 받은 사용자가 오는 곳.
# 기존에 쓰던 소셜(GOOGLE)로 로그인해 토큰을 받은 뒤 새 소셜(KAKAO)을 붙인다.
#
# 응답: {"providers": ["GOOGLE", "KAKAO"]}  ← 연결 후 전체 로그인 수단
@meToken = 기존_소셜로_로그인해서_받은_accessToken
POST {{host}}/api/v1/auth/social-links
Authorization: Bearer {{meToken}}
Content-Type: application/json

{ "provider": "KAKAO", "accessToken": "카카오_SDK_액세스토큰" }

### ⑼ 같은 소셜을 또 연결 — 200, 멱등
POST {{host}}/api/v1/auth/social-links
Authorization: Bearer {{meToken}}
Content-Type: application/json

{ "provider": "KAKAO", "accessToken": "카카오_SDK_액세스토큰" }

### ⑽ 같은 제공자의 다른 계정 — 409 DUPLICATE_RESOURCE
# 조용히 갈아치우면 원래 그 계정으로 로그인하던 사람이 못 들어온다.
POST {{host}}/api/v1/auth/social-links
Authorization: Bearer {{meToken}}
Content-Type: application/json

{ "provider": "KAKAO", "accessToken": "다른_카카오계정_액세스토큰" }

### ⑾ 로그인 없이 — 401
POST {{host}}/api/v1/auth/social-links
Content-Type: application/json

{ "provider": "KAKAO", "accessToken": "카카오_SDK_액세스토큰" }

### ⑿ 소셜 해제 — 수단이 둘 이상일 때만 된다
# 응답: {"providers": ["LOCAL"]}  ← 해제 후 남은 수단
DELETE {{host}}/api/v1/auth/social-links/KAKAO
Authorization: Bearer {{meToken}}

### ⒀ 마지막 하나를 떼려 하면 409 LAST_LOGIN_METHOD
# 떼면 사용자가 자기 계정에서 잠기고 되돌릴 방법이 없다.
# 프론트는 남은 수단이 하나면 버튼 자체를 비활성화한다.
DELETE {{host}}/api/v1/auth/social-links/GOOGLE
Authorization: Bearer {{meToken}}

### ⒁ LOCAL 은 이 API 로 못 뗀다 — 400
DELETE {{host}}/api/v1/auth/social-links/LOCAL
Authorization: Bearer {{meToken}}

### ⒂ 연결되지 않은 소셜 — 404
DELETE {{host}}/api/v1/auth/social-links/NAVER
Authorization: Bearer {{meToken}}

### ⒃ 로그인 없이 — 401
DELETE {{host}}/api/v1/auth/social-links/KAKAO
