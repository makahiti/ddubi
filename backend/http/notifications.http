### 알림 API 시나리오 (NTF-001~004)
#
# 사용법: auth.http 로 로그인해 accessToken 을 @token 에 넣는다.
#
# 알림 행은 추천 엔진이 NotificationService.create() 로 만든다(S15P21E202-38).
# 손으로 한 건 만들려면 맨 아래 ⑫ 개발용 테스트 발송을 쓴다 — dev 프로파일 전용이다.
# 억제 규칙이 그대로 적용되므로 실제 동작을 그대로 확인할 수 있다.
#
# 상태만 여러 개 깔아 두고 목록 조회를 시험할 거라면 SQL 이 더 빠르다.
#
#   docker exec ddubi-dev-mysql mysql -uddubi -pddubi ddubi -e "
#     INSERT INTO notification (user_id, type, title, body, status, sent_at) VALUES
#      (1,'DEPART_SOON','곧 출발하세요','10분 뒤 출발','SENT',NOW()),
#      (1,'LAST_TRIP','막차 주의','막차가 20분 뒤','SENT',NOW()),
#      (1,'MORNING_BRIEF','아침 브리핑','오늘 일정 2건','SUPPRESSED',NULL);"

@host = http://localhost:8080
@token = 여기에-액세스-토큰

### ① 목록 — unreadCount 가 함께 온다
GET {{host}}/api/v1/notifications?page=0&size=20
Authorization: Bearer {{token}}

> {%
    client.test("200 + unreadCount", function () {
        client.assert(response.status === 200);
        client.assert(response.body.data.unreadCount !== undefined);
        if (response.body.data.content.length > 0) {
            client.global.set("notificationId", response.body.data.content[0].id);
        }
    });
%}

### ② 안읽음만
GET {{host}}/api/v1/notifications?unreadOnly=true
Authorization: Bearer {{token}}

### ③ 종류 필터 — 목록은 줄어도 unreadCount 는 그대로다
# unreadCount 는 뱃지 숫자라 필터와 무관한 "안읽음 전체" 다.
GET {{host}}/api/v1/notifications?type=LAST_TRIP
Authorization: Bearer {{token}}

### ④ 잘못된 종류 — 400
GET {{host}}/api/v1/notifications?type=존재하지않음
Authorization: Bearer {{token}}

> {%
    client.test("400", function () {
        client.assert(response.status === 400);
    });
%}

### ⑤ 상세
GET {{host}}/api/v1/notifications/{{notificationId}}
Authorization: Bearer {{token}}

### ⑥ 읽음 처리
PATCH {{host}}/api/v1/notifications/{{notificationId}}/read
Authorization: Bearer {{token}}

> {%
    client.test("200", function () {
        client.assert(response.status === 200);
        client.global.set("firstReadAt", response.body.data.readAt);
    });
%}

### ⑦ 같은 알림 또 읽음 — 멱등. readAt 이 안 바뀐다
PATCH {{host}}/api/v1/notifications/{{notificationId}}/read
Authorization: Bearer {{token}}

> {%
    client.test("최초 읽은 시각이 유지된다", function () {
        client.assert(response.status === 200);
        client.assert(response.body.data.readAt === client.global.get("firstReadAt"));
    });
%}

### ⑧ 전체 읽음 — 안읽음이던 건수만 센다
PATCH {{host}}/api/v1/notifications/read-all
Authorization: Bearer {{token}}

> {%
    client.test("200 + updatedCount", function () {
        client.assert(response.status === 200);
        client.assert(response.body.data.updatedCount !== undefined);
    });
%}

### ⑨ 안읽음 없을 때 전체 읽음 — 0 건
PATCH {{host}}/api/v1/notifications/read-all
Authorization: Bearer {{token}}

> {%
    client.test("updatedCount = 0", function () {
        client.assert(response.body.data.updatedCount === 0);
    });
%}

### ⑩ 홈의 안읽음 수도 0 이 된다 (알림 도메인 경유)
GET {{host}}/api/v1/home
Authorization: Bearer {{token}}

### ⑪ 없는 알림 — 404
GET {{host}}/api/v1/notifications/999999
Authorization: Bearer {{token}}

> {%
    client.test("404", function () {
        client.assert(response.status === 404);
    });
%}

### ⑫ 개발용 테스트 발송 — 1차. status 가 SENT 여야 한다
# ddubi.dev-endpoints.enabled=true 일 때만 존재한다. 꺼져 있으면 404 다.
# 내 PC(dev 프로파일)는 켜져 있고, 배포 서버는 인프라가 환경변수로 켠다.
#
# ⚠️ title·body 는 필수다. 빼면 400 이다.
# ⚠️ scheduleId 는 내 일정이어야 한다. 없으면 404, 남의 것이면 403 (⑯ 참고).
#    아래 1 은 자리표시자다 — schedules.http 로 만든 내 일정 ID 로 바꿔 쓴다.
# ⚠️ 1차가 SUPPRESSED 로 오면 suppressReason 을 본다.
#      NO_VALID_DEVICE — FCM 토큰이 없다. users.http 의 기기 토큰 등록 먼저
#      ALARM_OFF       — 마이페이지에서 알림을 꺼 뒀다
#    그 상태로는 ⑬ 의 중복 억제(DUPLICATE)를 검증할 수 없다.
POST {{host}}/api/v1/dev/notifications/test
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "EARLY_DEPART",
  "title": "10분 일찍 나가세요",
  "body": "2호선 강남역 구간 지연으로 출발 시각이 앞당겨졌습니다.",
  "scheduleId": 1,
  "suppressKey": "delay-test-schedule-1"
}

> {%
    client.test("1차는 발송된다", function () {
        client.assert(response.status === 200);
        client.assert(response.body.data.status === "SENT",
            "SENT 가 아니면 기기 토큰/알림 설정을 먼저 확인하세요: " + response.body.data.status);
        client.global.set("suppressedTestId", response.body.data.id);
    });
%}

### ⑬ 같은 suppressKey 로 다시 — SUPPRESSED 여야 한다 (10분 이내)
# 억제돼도 행은 만들어진다. ① 목록에 두 건이 보이고 status 만 다르다.
POST {{host}}/api/v1/dev/notifications/test
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "EARLY_DEPART",
  "title": "10분 일찍 나가세요",
  "body": "2호선 강남역 구간 지연으로 출발 시각이 앞당겨졌습니다.",
  "scheduleId": 1,
  "suppressKey": "delay-test-schedule-1"
}

> {%
    client.test("2차는 중복으로 억제된다", function () {
        client.assert(response.status === 200);
        client.assert(response.body.data.status === "SUPPRESSED");
        client.assert(response.body.data.suppressReason === "DUPLICATE",
            "DUPLICATE 가 아니면 억제를 검증한 게 아니다: " + response.body.data.suppressReason);
        client.assert(response.body.data.sentAt === null);
    });
%}

### ⑭ 키를 바꾸면 다시 발송된다 — 억제가 키 단위임을 확인
POST {{host}}/api/v1/dev/notifications/test
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "EARLY_DEPART",
  "title": "10분 일찍 나가세요",
  "body": "2호선 강남역 구간 지연으로 출발 시각이 앞당겨졌습니다.",
  "scheduleId": 1,
  "suppressKey": "delay-test-schedule-2"
}

> {%
    client.test("다른 키는 발송된다", function () {
        client.assert(response.body.data.status === "SENT");
    });
%}

### ⑮ title 누락 — 400
# 프론트가 처음 보낸 형태(type/scheduleId/suppressKey 만)가 이 경우다.
POST {{host}}/api/v1/dev/notifications/test
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "EARLY_DEPART",
  "scheduleId": 1,
  "suppressKey": "delay-test-schedule-3"
}

> {%
    client.test("400", function () {
        client.assert(response.status === 400);
    });
%}

### ⑯ 남의 일정 ID — 403
# 알림에 붙일 일정은 내 것이어야 한다. 거절된 요청은 알림 행도 억제 키도 남기지 않는다.
POST {{host}}/api/v1/dev/notifications/test
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "EARLY_DEPART",
  "title": "남의 일정",
  "body": "붙으면 안 된다",
  "scheduleId": 99999,
  "suppressKey": "ownership-test"
}

> {%
    client.test("없거나 남의 일정이면 404/403", function () {
        client.assert(response.status === 404 || response.status === 403,
            "실제: " + response.status);
    });
%}

### ⑰ 아침 브리핑 — 수신 시각 설정
# briefingTime 이 NULL 이면 브리핑을 받지 않는다. 시각을 넣으면 그 시각부터 대상이 된다.
# 확인하려면 지금 시각보다 조금 앞선 값을 넣는다 (스케줄러가 1분마다 돈다).
PATCH {{host}}/api/v1/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "briefingTime": "07:00:00"
}

### ⑱ 브리핑이 왔는지 확인
# 스케줄러(기본 60초)가 돌면서 조건이 맞으면 한 건 만든다.
#
# 안 오면 순서대로 확인한다:
#   1. briefingTime 이 지금보다 과거인가         — 미래면 아직이다
#   2. 지난 지 2시간이 넘지 않았나               — 넘으면 그날은 건너뛴다
#   3. 오늘 남은 일정이 있나                     — 0건이면 보내지 않는다(빈 브리핑은 소음)
#   4. 오늘 이미 받지 않았나                     — 하루 한 번이다
#   5. ddubi.briefing.enabled 가 true 인가       — 끄면 스케줄러 자체가 없다
GET {{host}}/api/v1/notifications?type=MORNING_BRIEF
Authorization: Bearer {{token}}

> {%
    client.test("브리핑이 있으면 제목·본문 형식을 본다", function () {
        client.assert(response.status === 200);
        const items = response.body.data.content;
        if (items.length > 0) {
            client.assert(/^오늘 일정 \d+건$/.test(items[0].title), "제목: " + items[0].title);
            client.assert(items[0].scheduleId !== null, "탭했을 때 갈 일정이 있어야 한다");
        }
    });
%}

### ⑲ 다시 보내지지 않는지 — 하루 한 번
# 스케줄러가 1분마다 돌지만 같은 날에는 한 건이어야 한다.
# 위 ⑱ 을 몇 분 뒤 다시 호출해 개수가 그대로인지 본다.
GET {{host}}/api/v1/notifications?type=MORNING_BRIEF
Authorization: Bearer {{token}}
