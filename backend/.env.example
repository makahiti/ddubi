# 백엔드 환경변수 템플릿.
#
# 사용법: 이 파일을 복사해서 .env 를 만들고 값을 채운다.
#     cp backend/.env.example backend/.env
#
# - 이 파일(.env.example)은 변수 이름만 두고 커밋한다.
# - 실제 값이 든 .env 는 커밋하지 않는다(.gitignore 등록됨).
# - dev 프로파일은 application-dev.yml 의 spring.config.import 로 .env 를 읽는다.
#   운영에서는 .env 를 쓰지 않고 OS 환경변수로 주입한다.
#
# 배포 환경 변수는 infra/.env.example 이 원천이며 여기와 이름을 맞춘다.

SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# --- MySQL ---
# backend/docker-compose.dev.yml 의 기본값과 맞춰져 있다.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ddubi
MYSQL_USER=ddubi
MYSQL_PASSWORD=ddubi

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# HS256 이라 최소 32바이트. 없거나 짧으면 기동이 실패한다(JwtTokenProvider).
#
# ⚠️ 빈 값으로 두지 말 것. .env 의 빈 값은 "값 없음"이 아니라 "빈 문자열"로 취급되어
#    application-dev.yml 의 기본값을 덮어쓰고 기동이 실패한다.
#    아래는 로컬 전용 값이다. 운영에서는 OS 환경변수로 다른 값을 주입한다.
JWT_SECRET=ddubi-local-dev-only-secret-key-do-not-use-in-production

# --- 외부 API ---
# 카카오 REST API 키 하나로 세 가지를 모두 호출한다.
#   1) 대중교통 길찾기  GET /v2/routing/publictraffic
#   2) 로컬 장소 검색   /places/search 프록시
#   3) 로그인 토큰 교환 /auth/oauth
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키.
#
# ⚠️ 프론트가 카카오 로그인에 쓰는 앱과 반드시 동일한 앱이어야 한다.
#    인가 코드는 앱 단위로 발급되어 다른 앱의 키로는 교환되지 않는다.
# ⚠️ 테스트앱은 일일 쿼터가 소량이다. 길찾기까지 같은 키를 쓰므로 금방 소진된다.
KAKAO_REST_API_KEY=

# 카카오 로그인 클라이언트 시크릿.
# 콘솔 > 카카오 로그인 > 보안 에서 "코드 발급" 을 활성화했다면 반드시 넣어야 한다.
# 켜 놓고 안 보내면 토큰 교환이 KOE010 으로 실패한다.
KAKAO_CLIENT_SECRET=

# 카카오 개발자 콘솔 > 내 애플리케이션에 표시되는 숫자 앱 ID.
# 모바일 SDK가 발급한 토큰이 DDUBI 앱의 토큰인지 검증할 때 사용한다.
KAKAO_APP_ID=

# --- 구글 로그인 ---
# GCP 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션).
# 승인된 리디렉션 URI 에 프론트 콜백 주소를 등록해야 한다(로컬: http://localhost:3001/oauth/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 네이버 로그인 ---
# 네이버 개발자센터 > 애플리케이션 등록 > 네아로(네이버 아이디로 로그인).
# 서비스 URL 과 Callback URL 을 등록해야 한다(로컬: http://localhost:3001/oauth/naver).
#
# ⚠️ 네이버는 토큰 교환에 state 가 필수다. 프론트가 인가 요청에 쓴 state 를
#    /auth/oauth 요청 본문에 그대로 실어 보내야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 메일 (회원가입 이메일 인증) ---
# 비워두면 인증 코드를 실제로 보내지 않고 서버 로그에만 찍는다.
# 로컬 개발은 그대로 두고 로그에서 코드를 확인하면 된다.
#
# 실제 발송하려면 Gmail 2단계 인증을 켜고 "앱 비밀번호"를 발급받아 넣는다.
#   https://myaccount.google.com/apppasswords
# ⚠️ 구글 계정 로그인 비밀번호가 아니다. 앱 비밀번호(16자리)여야 한다.
# ⚠️ SSAFY 교육망이 587 아웃바운드를 막으면 발송이 타임아웃된다.
#    그때는 MAIL_HOST 를 smtp.naver.com 으로 바꾸거나 로그 발송기로 개발한다.
MAIL_USERNAME=
MAIL_PASSWORD=
# --- 서울 교통 마스터 관리 적재 ---
# 일반 실행은 false. 공식 XLSX/CSV를 새 data-version으로 적재하는 관리 실행에서만 true.
DDUBI_TRANSIT_MASTER_IMPORT_ENABLED=false
DDUBI_TRANSIT_MASTER_DATA_VERSION=
DDUBI_TRANSIT_MASTER_BUS_WORKBOOK=
DDUBI_TRANSIT_MASTER_SUBWAY_TIMETABLE=
DDUBI_TRANSIT_MASTER_SUBWAY_REALTIME_STATIONS=
DDUBI_TRANSIT_MASTER_ALIASES=

# BUS path 첫·끝과 공식 정류장 사이 EXACT 허용 반경(m). 실제 검증셋으로 조정한다.
DDUBI_BUS_MAPPING_MAX_ENDPOINT_DISTANCE_METERS=150
DDUBI_TRANSIT_MAPPING_REFRESH_INTERVAL_MS=60000
