# 백엔드 환경변수 템플릿.
#
# 사용법: 이 파일을 복사해서 .env 를 만들고 값을 채운다.
#     cp backend/.env.example backend/.env
#
# - 이 파일(.env.example)은 변수 이름만 두고 커밋한다.
# - 실제 값이 든 .env 는 커밋하지 않는다(.gitignore 등록됨).
# - dev 프로파일은 application-dev.yml 의 spring.config.import 로 .env 를 읽는다.
#   운영에서는 .env 를 쓰지 않고 OS 환경변수로 주입한다.
#
# 배포 환경 변수는 infra/.env.example 이 원천이며 여기와 이름을 맞춘다.

SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# --- MySQL ---
# backend/docker-compose.dev.yml 의 기본값과 맞춰져 있다.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ddubi
MYSQL_USER=ddubi
MYSQL_PASSWORD=ddubi

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# HS256 이라 최소 32바이트. 없거나 짧으면 기동이 실패한다(JwtTokenProvider).
#
# ⚠️ 빈 값으로 두지 말 것. .env 의 빈 값은 "값 없음"이 아니라 "빈 문자열"로 취급되어
#    application-dev.yml 의 기본값을 덮어쓰고 기동이 실패한다.
#    아래는 로컬 전용 값이다. 운영에서는 OS 환경변수로 다른 값을 주입한다.
JWT_SECRET=ddubi-local-dev-only-secret-key-do-not-use-in-production

# --- 외부 API ---
# 카카오 REST API 키 하나로 세 가지를 모두 호출한다.
#   1) 대중교통 길찾기  GET /v2/routing/publictraffic
#   2) 로컬 장소 검색   /places/search 프록시
#   3) 로그인 토큰 교환 /auth/oauth
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키.
#
# ⚠️ 프론트가 카카오 로그인에 쓰는 앱과 반드시 동일한 앱이어야 한다.
#    인가 코드는 앱 단위로 발급되어 다른 앱의 키로는 교환되지 않는다.
# ⚠️ 테스트앱은 일일 쿼터가 소량이다. 길찾기까지 같은 키를 쓰므로 금방 소진된다.
KAKAO_REST_API_KEY=

# 카카오 로그인 클라이언트 시크릿.
# 콘솔 > 카카오 로그인 > 보안 에서 "코드 발급" 을 활성화했다면 반드시 넣어야 한다.
# 켜 놓고 안 보내면 토큰 교환이 KOE010 으로 실패한다.
KAKAO_CLIENT_SECRET=

# 카카오 개발자 콘솔 > 내 애플리케이션에 표시되는 숫자 앱 ID.
# 모바일 SDK가 발급한 토큰이 DDUBI 앱의 토큰인지 검증할 때 사용한다.
KAKAO_APP_ID=

# --- 구글 로그인 ---
# GCP 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션).
# 승인된 리디렉션 URI 에 프론트 콜백 주소를 등록해야 한다(로컬: http://localhost:3001/oauth/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 네이버 로그인 ---
# 네이버 개발자센터 > 애플리케이션 등록 > 네아로(네이버 아이디로 로그인).
# 서비스 URL 과 Callback URL 을 등록해야 한다(로컬: http://localhost:3001/oauth/naver).
#
# ⚠️ 네이버는 토큰 교환에 state 가 필수다. 프론트가 인가 요청에 쓴 state 를
#    /auth/oauth 요청 본문에 그대로 실어 보내야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 메일 (회원가입 이메일 인증) ---
# 비워두면 인증 코드를 실제로 보내지 않고 서버 로그에만 찍는다.
# 로컬 개발은 그대로 두고 로그에서 코드를 확인하면 된다.
#
# 실제 발송하려면 Gmail 2단계 인증을 켜고 "앱 비밀번호"를 발급받아 넣는다.
#   https://myaccount.google.com/apppasswords
# ⚠️ 구글 계정 로그인 비밀번호가 아니다. 앱 비밀번호(16자리)여야 한다.
# ⚠️ SSAFY 교육망이 587 아웃바운드를 막으면 발송이 타임아웃된다.
#    그때는 MAIL_HOST 를 smtp.naver.com 으로 바꾸거나 로그 발송기로 개발한다.
MAIL_USERNAME=
MAIL_PASSWORD=
# --- 서울 지하철 마스터 관리 적재 ---
# 일반 실행은 false. 공식 지하철 CSV를 새 data-version으로 적재하는 관리 실행에서만 true.
DDUBI_TRANSIT_MASTER_IMPORT_ENABLED=false
DDUBI_TRANSIT_MASTER_DATA_VERSION=
DDUBI_TRANSIT_MASTER_SUBWAY_TIMETABLE=
DDUBI_TRANSIT_MASTER_SUBWAY_REALTIME_STATIONS=
DDUBI_TRANSIT_MASTER_ALIASES=

# 두 교통수단 마스터의 활성 버전 확인 주기(ms).
DDUBI_TRANSIT_MAPPING_REFRESH_INTERVAL_MS=60000

# --- 지하철 추천 시간표 ---
# backend/tools/transit-timing/build_timetable.py가 만든 운행일별 JSON의 절대경로.
# 원본 CSV가 아니라 timetable.json을 지정한다. 파일은 백엔드 시작 시 한 번 읽는다.
# Windows 예: C:/workspace/S15P21E202/backend/target/transit-timing/timetable.json
DDUBI_SUBWAY_TIMING_TIMETABLE_PATH=
# 카카오 총시간에서 지하철 대기시간이 빠졌다는 실측 검증 전에는 반드시 false를 유지한다.
DDUBI_SUBWAY_TIMING_DECOMPOSITION_VERIFIED=false

# --- FCM (푸시 알림) ---
# 둘 다 비우면 실제 발송 없이 코드를 로그에만 남긴다. 키 없이도 개발이 된다.
#
# Firebase 콘솔 > ⚙️ 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성" 으로 받은 JSON.
#   https://console.firebase.google.com
# ⚠️ client/android/app/google-services.json 과 다른 파일이다. 그건 프론트용.
# ⚠️ 이 키 하나로 누구나 우리 프로젝트 이름의 푸시를 보낼 수 있다. 절대 커밋 금지.
#
# 로컬은 파일 경로, 배포·팀 공유는 base64 를 쓴다(환경변수 한 줄로 주입 가능).
#   base64 만들기: base64 -w0 firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_BASE64=
# 수도권 버스 관리 적재. SHA는 artifact manifest에서 읽으며 실제 비밀값이 아니다.
DDUBI_METROPOLITAN_BUS_IMPORT_ENABLED=false
DDUBI_METROPOLITAN_BUS_ARTIFACT=
DDUBI_METROPOLITAN_BUS_SHA256=

# 검토 참고자료 공개 조회. 기존 운영 baseline/시간표/통제 활성화와 무관하며 기본 미설정.
DDUBI_BUS_REFERENCE_DATA_VERSION=
# 전체 DB 행수/청크수 확인 후 과거 평균 RIDE fallback만 활성화. 실시간/ML 승인이 아님.
DDUBI_BUS_REFERENCE_FALLBACK_ENABLED=false
DDUBI_BUS_REFERENCE_FALLBACK_EXPECTED_ROWS=0
DDUBI_BUS_REFERENCE_FALLBACK_EXPECTED_CHUNKS=0
DDUBI_BUS_REFERENCE_FALLBACK_MAX_AGE_DAYS=90
DDUBI_BUS_REFERENCE_FALLBACK_MIN_SAMPLES=3
DDUBI_BUS_REFERENCE_FALLBACK_MIN_DATES=3
DDUBI_BUS_REFERENCE_FALLBACK_MAX_FUTURE_DAYS=7
DDUBI_BUS_REFERENCE_FALLBACK_SAMPLE_KIND=HOURLY_SOURCE_MEAN
DDUBI_REFERENCE_PACKAGES_SUBWAY_PATH=
DDUBI_REFERENCE_PACKAGES_SUBWAY_SHA256=
DDUBI_REFERENCE_PACKAGES_ROAD_PATH=
DDUBI_REFERENCE_PACKAGES_ROAD_SHA256=
