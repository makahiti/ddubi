# 백엔드 환경변수 — 변수명만 둔다. 실제 값이 든 .env 는 커밋 금지.
# 배포 환경 변수는 infra/.env.example 이 원천이며 여기와 이름을 맞춘다.

SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ddubi
MYSQL_USER=ddubi
MYSQL_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# HS256 기준 최소 32바이트. 운영에서 비워두지 말 것.
JWT_SECRET=

# --- 외부 API ---
KAKAO_REST_API_KEY=
