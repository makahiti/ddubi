root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# 언어별 규칙. 포매터(Spotless·dart format·Ruff)가 같은 값을 쓴다(2026-09-18).
[*.java]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 120

[*.dart]
indent_size = 2
max_line_length = 80

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
