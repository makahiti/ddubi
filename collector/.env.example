# 공공데이터포털 공통 인증키: 버스 도착·위치, 경기·인천 선택 수집기, 날씨 대체 경로
DATA_GO_KR_API_KEY=

# 기상청 API 허브(날씨 우선 경로)
KMA_API_KEY=

# 서울 열린데이터광장 실시간 지하철 인증키
SUBWAY_API_KEY=

# 서울 열린데이터광장 일반 인증키: 지하철 알림, 실시간 도시데이터, TOPIS 공지, 실시간 돌발
SEOUL_OPEN_DATA_API_KEY=

# Kafka 전송 성공 공지 기록. 비우면 collector/data/topis_notice_dedup.sqlite3
TOPIS_NOTICE_DEDUP_PATH=
TOPIS_NOTICE_PAGE_SIZE=100
TOPIS_NOTICE_DAILY_BUDGET=500
TOPIS_NOTICE_QUOTA_POOL=seoul-open-data:OA-22861
TOPIS_NOTICE_WEEKDAY_PEAK_WINDOWS=06:30-09:30,16:30-20:00
TOPIS_NOTICE_ACTIVE_WINDOWS=05:00-24:00
TOPIS_NOTICE_PEAK_INTERVAL_SECONDS=300
TOPIS_NOTICE_OFFPEAK_INTERVAL_SECONDS=600
TOPIS_NOTICE_OVERNIGHT_INTERVAL_SECONDS=3600
# 실시간 돌발정보: 평일 첨두 5분, 그 외 운행시간 10분, 심야 15분
TRAFFIC_INCIDENT_WEEKDAY_PEAK_WINDOWS=06:30-09:30,16:30-20:00
TRAFFIC_INCIDENT_ACTIVE_WINDOWS=05:30-23:30
TRAFFIC_INCIDENT_PEAK_INTERVAL_SECONDS=300
TRAFFIC_INCIDENT_OFFPEAK_INTERVAL_SECONDS=600
TRAFFIC_INCIDENT_OVERNIGHT_INTERVAL_SECONDS=900

# Kafka 서버 실행 시 적용. 기본 상태 파일은 collector/data/request_budget.sqlite3
API_DAILY_LIMIT=900
# 도시데이터 121개 장소를 5분마다 수집할 때 하루 34,848회. 아래 값은 공급자 공지 한도가 아닌 내부 안전 한도다.
CITY_REALTIME_DAILY_BUDGET=40000
CITY_REALTIME_QUOTA_POOL=seoul-open-data:OA-21285
# 두 키 모두 버스 도착·위치 활용신청 승인을 받은 키여야 한다.
BUS_API_KEY_A=
BUS_API_KEY_B=
BUS_ARRIVAL_DAILY_BUDGET_PER_KEY=9000
BUS_LOCATION_DAILY_BUDGET_PER_KEY=9000
BUS_ARRIVAL_QUOTA_POOL=data-go-kr:15000314
BUS_LOCATION_QUOTA_POOL=data-go-kr:15000332
API_BUDGET_PATH=

# 버스는 전체 노선 목록을 보존하되 앞의 100개까지만 수집한다.
BUS_ROUTE_LIMIT=100
BUS_WEEKDAY_PEAK_WINDOWS=06:30-09:30,16:30-20:00
BUS_SERVICE_WINDOWS=05:30-23:30
BUS_ARRIVAL_PEAK_INTERVAL_SECONDS=300
BUS_ARRIVAL_OFFPEAK_INTERVAL_SECONDS=900
BUS_ARRIVAL_WEEKEND_INTERVAL_SECONDS=1800
BUS_ARRIVAL_OVERNIGHT_INTERVAL_SECONDS=1800
BUS_LOCATION_DENSE_INTERVAL_SECONDS=150
BUS_LOCATION_SPARSE_INTERVAL_SECONDS=300
BUS_LOCATION_DENSE_ROUTE_COUNT=50
BUS_LOCATION_OFFPEAK_INTERVAL_SECONDS=900
BUS_LOCATION_WEEKEND_INTERVAL_SECONDS=900
BUS_LOCATION_OVERNIGHT_INTERVAL_SECONDS=3600
# 단일 노선 점검은 실행 시 --bus-route-id 옵션을 사용한다.

# Backend 마스터에서 생성한 고정 대응표. Spark에도 동일 파일과 manifest SHA를 지정한다.
# 비어 있으면 provider 관측은 유지하고 canonicalMapping은 UNRESOLVED로 발행한다.
BUS_CROSSWALK_PATH=
BUS_CROSSWALK_SHA256=
