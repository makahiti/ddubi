APP_ENV=local
APP_VERSION=0.1.0
TZ=Asia/Seoul

# MySQL (주 DB). Backend 만 접근한다. ROOT 비밀번호는 mysql 이미지 초기화에 필수
# 비밀번호 칸은 비워 둔다. 예전에는 change-me 같은 자리표시자가 들어 있어 그대로 복사해도 서비스가 떠 버렸다(2026-09-18 PM 점검 지적).
# 지금은 compose 가 이 값들을 필수로 요구하므로 비어 있으면 시작을 거부한다. 값은 `openssl rand -base64 24` 로 만들어 넣는다.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ddubi
MYSQL_USER=ddubi
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# mysqld-exporter 전용 최소 권한 계정(PROCESS·REPLICATION CLIENT·performance_schema SELECT). 서버2에서 생성해 서버 .env 에만 둔다
MYSQL_EXPORTER_PASSWORD=change-me-exporter
# 개발 PC 에서 접속할 호스트 포트(127.0.0.1 전용). 로컬에 MySQL 이 이미 있으면 3307 등으로 바꾼다
MYSQL_HOST_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
# 비워 두면 compose 가 시작을 거부한다. 이 값이 빈 채로 뜨면 redis 가 비밀번호 없는 상태가 되므로 특히 중요하다.
REDIS_PASSWORD=

# Kafka: 컨테이너 내부 kafka:9092 / 호스트(개발 PC) localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# 보존 21일. HDFS 정착(3단계) 후에만 단축한다
KAFKA_RETENTION_HOURS=504
KAFKA_RETENTION_BYTES=1073741824
KAFKA_UI_PORT=8085

# Spark 체크포인트·이벤트로그 위치. HDFS 3단계 적용 상태 (hdfs 프로필 필요).
# HDFS 없이 로컬로 돌리려면: /opt/ddubi/checkpoints, /opt/ddubi/spark-events (compose 볼륨 경로)
SPARK_CHECKPOINT_DIR=hdfs://hdfs-namenode:9000/ddubi/checkpoints
SPARK_EVENTLOG_DIR=hdfs://hdfs-namenode:9000/ddubi/spark-events
SPARK_MASTER_UI_PORT=8080
SPARK_DRIVER_UI_PORT=4040
SPARK_REALTIME_DRIVER_UI_PORT=4042
# --- Spark 자원 배분 (2026-09-07, 코어 2026-09-18 재계산) ---
# worker 1대가 executor 에 내줄 수 있는 총량. 컨테이너 mem_limit(3g) 은 이 값 + JVM 부대비용보다 커야 한다.
# 기본 스트리밍 세 잡(768m×3) + 배치(480m)는 worker 두 대의 전체 자원 안에서 실행한다.
SPARK_WORKER_MEMORY=2560m
#
# 칸(코어) 계산 — 2026-09-18 city-realtime 이 기본 프로필에 들어오면서 다시 셌다.
#   weather 1 + realtime 2 + city-realtime 1 = 스트리밍 4칸
#   batch 2칸
#   필요 6칸인데 worker 2대×2 = 4칸뿐이라 배치가 칸을 하나도 못 받고 무한 대기했다.
# 그래서 worker 당 3칸으로 올린다. 6칸이 되어 배치까지 들어간다.
#
# 물리 코어는 4개지만 칸은 "동시에 몇 개 돌릴까"이지 CPU 개수가 아니다. 스트리밍 잡은
# Kafka 를 기다리는 시간이 대부분이라 실제 CPU 사용률이 서버1 기준 3% 수준이다(2026-09-18 실측).
# 메모리는 768m×4 + 480m×2 = 4,032m 로 worker 두 대의 5,120m 안에 들어간다.
# 되돌릴 때는 이 값만 2 로 내리면 된다.
SPARK_WORKER_CORES=3
# 잡별 executor. 코어는 잡당 1이지만 realtime 만 2 (아래 설명). 배치는 아래 BATCH_*
STREAMING_EXECUTOR_MEMORY=768m
STREAMING_CORES_MAX=1
REALTIME_EXECUTOR_MEMORY=768m
# realtime 은 스트림 2개(메인 Redis 최신값 + 버스 Silver HDFS)를 함께 돌리므로 코어 2, 각 스트림에 1개씩.
# 1로 내리면 버스 유입(8시간 주기) 때 두 스트림이 코어를 다퉈 서비스 Redis 가 밀릴 수 있다 (2026-09-16 스트림 분리).
REALTIME_CORES_MAX=2
# 도시 실시간 Silver (2026-09-18 추가). compose 기본값에만 있어 여기 보이지 않던 것을 드러낸다.
CITY_STREAMING_EXECUTOR_MEMORY=768m
CITY_STREAMING_CORES_MAX=1
# realtime 드라이버는 버스 대응표(인접 구간 10만 행)를 기동 때 DataFrame 으로 올려 조인하므로 힙 2g, 컨테이너 2560m (9/11)
REALTIME_DRIVER_MEMORY=2g
REALTIME_MEM_LIMIT=2560m
# Spark realtime의 버스 대응표. Collector와 같은 검증 파일/지문을 사용한다.
SPARK_BUS_CROSSWALK_PATH=/opt/ddubi/transit-master/bus/metropolitan-bus-v6.crosswalk.json.gz
SPARK_BUS_CROSSWALK_SHA256=8014da5e1453d426789fa396622a0f0e4069ac484db76860348af517adc1f246
# 체크포인트가 없을 때 어디서부터 읽을지 (latest|earliest). 이벤트로그는 히스토리 서버 도입 전까지 꺼둔다
SPARK_STARTING_OFFSETS=latest
SPARK_EVENTLOG_ENABLED=false

# 기준선 배치 (sparkjobs/batch). 입력은 archiver 가 쓴 아카이브를 Spark 가 hdfs:// RPC 로 읽는다
BASELINE_INPUT_URI=hdfs://hdfs-namenode:9000/ddubi/archive
BASELINE_OUTPUT_URI=hdfs://hdfs-namenode:9000/ddubi/baseline
BASELINE_WINDOW_DAYS=28
# 운영에서 날씨 Silver를 켤 때: hdfs://hdfs-namenode:9000/ddubi/silver
SILVER_OUTPUT_URI=
WEATHER_REQUIRE_SILVER=false
BUS_SILVER_OUTPUT_URI=hdfs://hdfs-namenode:9000/ddubi/silver/bus/realtime-v1
# 비우면 City Silver HDFS만 꺼지고 Redis 최신값은 계속 갱신된다.
CITY_SILVER_OUTPUT_URI=
CITY_SILVER_FRESHNESS_SECONDS=900
WEATHER_SILVER_TRIGGER=10 minutes
WEATHER_SILVER_WATERMARK=2 days
# 실제 구간 통과 파이프라인. registry/baseline은 검증 산출물을 만든 뒤에만 채우고 recommendation-data 프로필을 켠다.
SEGMENT_FACTS_PATH=hdfs://hdfs-namenode:9000/ddubi/silver/segment-observation/v1
SEGMENT_REGISTRY_PATH=
SEGMENT_BASELINE_PATH=
SEGMENT_STATUS_OUTPUT_PATH=hdfs://hdfs-namenode:9000/ddubi/derived/segment-status/v1
SEGMENT_STATUS_POLICY_VERSION=segment-status-v1
SEGMENT_STATUS_SLOW_SECONDS=30
SEGMENT_STATUS_DELAYED_SECONDS=60
SEGMENT_STATUS_MIN_SAMPLES=3
SEGMENT_STATUS_MAX_AGE_SECONDS=300
# 기준선 업로드 API (docs/contracts/internal-api.yaml). backend Phase 5 전까지는 mock 주소 사용 가능
# 서버1 에서는 반드시 서버2 **사설 IP** 로: http://172.26.6.220 (공인 도메인으로 가면 출발 IP 가 공인 IP 가 되어 nginx 의 서버1 IP 제한에 걸림)
# 로컬/mock: http://<mock호스트>:8099 (tests/mock_baseline_server.py)
# INTERNAL_API_KEY 는 서버1(Spark 배치)·서버2(Spring) .env 에 같은 값. 서버에서 생성, 커밋 금지
INTERNAL_API_BASE_URL=
INTERNAL_API_KEY=
# 기준선 activate 급감 허용(정상 축소일 때만, 1회성). true 면 BASELINE_SHRINK_REASON 필수. 실행 뒤 비운다
BASELINE_ALLOW_SHRINK=
BASELINE_SHRINK_REASON=
# 배치 실행기 자원. 워커 2560m 중 스트리밍 두 잡이 1536m 을 쓰고 남는 범위 안, Spark 최소 450m 이상
BATCH_EXECUTOR_MEMORY=480m
BATCH_CORES_MAX=2
# 부하 실험용 스트리밍(experiment 프로필). 운영 스트리밍을 멈춘 상태에서 워커 자원을 전부 쓴다
EXPERIMENT_EXECUTOR_MEMORY=1g
EXPERIMENT_CORES_MAX=4
EXPERIMENT_MAX_OFFSETS_PER_TRIGGER=200000

# Archiver: Kafka → Parquet. 1시간 또는 128MB 단위 병합. HDFS 3단계 적용 상태 (WebHDFS, hdfs 프로필 필요).
# HDFS 없이 로컬로 돌리려면: ARCHIVE_URI=file:///opt/ddubi/archive
ARCHIVE_TOPICS=transport.raw,city.raw,source.poll-status,segment.status
ARCHIVE_LOCAL_DIR=/opt/ddubi/archive
ARCHIVE_URI=webhdfs://hdfs-namenode:9870/ddubi/archive
ARCHIVE_HDFS_USER=hadoop
ARCHIVE_FLUSH_MINUTES=60
ARCHIVE_MAX_BYTES=134217728

HDFS_NAMENODE_URI=hdfs://hdfs-namenode:9000
# 복제 계수는 환경변수가 아니라 두 파일에 고정되어 있다 (둘을 같은 값으로 유지):
#  - infra/hdfs/hdfs-site.xml dfs.replication      : HDFS 데몬·WebHDFS(아카이버) 쪽 기본값
#  - infra/spark/spark-defaults.conf spark.hadoop.dfs.replication : Spark 가 hdfs:// 로 쓸 때의 값
#    (복제 계수는 "쓰는 클라이언트"가 정하므로 Spark 쪽에도 따로 필요)

SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
NOTIFICATION_PORT=8081
# backend JWT 서명 키. 비어 있으면 backend 가 기동을 거부한다. 강한 무작위 문자열(32자+)로 설정
JWT_SECRET=

# 대중교통 정적 마스터 폴더. 기본값은 저장소의 backend/transit-master (수도권 버스 마스터·대응표가 여기 있다, 2026-09-11).
# 지하철 시간표 CSV 같은 저장소 밖 파일을 쓸 때만 다른 폴더를 지정한다. 컨테이너 안에서는 /opt/ddubi/transit-master 로 보인다.
TRANSIT_MASTER_DATA_DIR=../backend/transit-master
# 수도권 버스 마스터(V4) 관리 적재. 일반 기동은 false. 적재는 backend 팀과 함께 true 로 한 번 재기동한 뒤 false 로 되돌린다.
# ARTIFACT·SHA256 기본값은 compose 에 있다(manifest 의 sha256). 파일을 새로 만들었을 때만 여기서 덮어쓴다.
DDUBI_METROPOLITAN_BUS_IMPORT_ENABLED=false
DDUBI_METROPOLITAN_BUS_ARTIFACT=
DDUBI_TRANSIT_MAPPING_SUBWAY_MASTER_RESOURCE=

# ml-serving 이 읽는 모델 묶음 폴더(서버2 호스트 경로). 컨테이너 안에서는 항상 /models/v12 로 보인다.
# 운영 서버2는 저장소 밖 /home/ubuntu/ddubi-models/<버전>/ 에 버전별 폴더로 둔다(2026-09-14 부터). 새 묶음이 오면 새 폴더에 설치하고
# 이 값만 바꾼 뒤 ml-serving 을 다시 만든다. 절차는 docs/runbooks/ml-bundle-swap.md. 아래 기본값은 로컬 개발용 위치다.
ML_BUNDLE_DIR=../artifacts/ml-serving/20260908-v12
ML_MAX_WAITING_REQUESTS=4
# 대기 상한(초). 백엔드 호출 제한보다 충분히 짧아야 밀린 요청이 빨리 실패하고 fallback 으로 넘어간다.
ML_QUEUE_WAIT_SECONDS=2
ML_REFERENCE_CACHE_MIB=256
ML_REDIS_LATEST_FEATURES_ENABLED=false
# Redis 대응표가 현재 버스 crosswalk와 같은 버전인지 확인한다. 기본값은 현재 저장소 SHA.
ML_BUS_CROSSWALK_SHA256=
ML_REDIS_TIMEOUT_SECONDS=1.5
ML_ONLINE_FEATURE_TTL_SECONDS=900
DDUBI_RECOMMENDATION_ML_PREVIEW_BASE_URL=http://ml-serving:8000
# 검증된 공식 지하철 시간표를 준비한 뒤 컨테이너 내부 경로를 넣는다. 없으면 비워 두며 Backend가 fail-closed 한다.
DDUBI_SUBWAY_TIMING_TIMETABLE_PATH=
DDUBI_SUBWAY_TIMING_DECOMPOSITION_VERIFIED=false
DDUBI_BUS_WAITING_DECOMPOSITION_VERIFIED=false
# ML 호출 한 건의 제한(밀리초). 코드 상한 10000. 실측 단독 응답 약 4초 기준 7000 을 쓴다.
DDUBI_RECOMMENDATION_ML_PREVIEW_TIMEOUT_MS=7000
# 버스 ML 적용 모드(2026-09-18). SHADOW=숫자만 기록하고 시간 계산에 쓰지 않음(운영 기본).
# TEST_APPLY=테스트 환경에서만 검증용 숫자를 시험 적용(응답에 ML_TEST_APPLIED 표시, productionReady 는 false 유지).
# PRODUCTION=운영 계약을 모두 만족한 응답만 적용. 되돌리기는 이 값을 SHADOW 로 바꾸고 backend 재기동.
DDUBI_RECOMMENDATION_ML_APPLY_MODE=SHADOW

# 카카오 도보: 기본은 provider 경로의 승하차 끝점 사용. 역 출입구 EXACT 검증을 의미하지 않는다.
DDUBI_WALKING_ENABLED=true
DDUBI_WALKING_PROVIDER_ENDPOINTS=true
# 공식 좌표 artifact 사용 시 기존 /opt/ddubi/transit-master 읽기 전용 마운트 안의 경로 지정.
DDUBI_WALKING_MASTER_COORDINATE_PATH=
DDUBI_WALKING_ENDPOINT_MAX_METERS=0
# TEST_APPLY 는 아래 값이 true 여야만 기동한다(실수 방지). 두 값을 함께 지정해야 시험 적용이 켜진다.
DDUBI_RECOMMENDATION_ML_TEST_APPLY_ALLOWED=false

# 알림 스위치 (2026-09-18)
# 자동 발송: 평가 결과로 FCM 을 보낸다. 지금 나가는 숫자는 미승인 모델 값이라 기본 false 다.
#            연동 확인 때만 true 로 두고 발표 전에 되돌린다.
DDUBI_AUTO_NOTIFY_ENABLED=false
# 아침 브리핑 스케줄러. false 면 스케줄러 빈 자체가 만들어지지 않는다.
DDUBI_BRIEFING_ENABLED=true
# 개발용 테스트 알림(POST /api/v1/dev/notifications/test). 켜면 본인에게 알림을 임의로 만든다.
DDUBI_DEV_ENDPOINTS_ENABLED=false
# 평가 예산 중 ML 호출 비율(0~1)과 계산 예산(밀리초: 첫 계산 / 자동 갱신 / 수동 다시 계산). 앱 안내(30초·10초)와 맞춘다.
DDUBI_RECOMMENDATION_ML_BUDGET_SHARE=0.6
DDUBI_RECOMMENDATION_BUDGET_INITIAL_MILLIS=30000
DDUBI_RECOMMENDATION_BUDGET_AUTO_REFRESH_MILLIS=15000
DDUBI_RECOMMENDATION_BUDGET_MANUAL_REFRESH_MILLIS=10000
DDUBI_METROPOLITAN_BUS_SHA256=

# 3단계 검토 참고자료. 값 없음=미설정, 조회 허용은 운영 추천 활성화와 다르다.
# 버스는 전체 청크 업로드 후 서버 행수/청크수 read-back이 일치한 버전만 기입한다.
DDUBI_BUS_REFERENCE_DATA_VERSION=
# 전체 DB 행수/청크수 확인 후 과거 평균 RIDE fallback만 활성화. 실시간/ML 승인이 아님.
DDUBI_BUS_REFERENCE_FALLBACK_ENABLED=false
DDUBI_BUS_REFERENCE_FALLBACK_EXPECTED_ROWS=0
DDUBI_BUS_REFERENCE_FALLBACK_EXPECTED_CHUNKS=0
DDUBI_BUS_REFERENCE_FALLBACK_MAX_AGE_DAYS=90
DDUBI_BUS_REFERENCE_FALLBACK_MIN_SAMPLES=3
DDUBI_BUS_REFERENCE_FALLBACK_MIN_DATES=3
DDUBI_BUS_REFERENCE_FALLBACK_MAX_FUTURE_DAYS=7
DDUBI_BUS_REFERENCE_FALLBACK_SAMPLE_KIND=HOURLY_SOURCE_MEAN
# 파일은 TRANSIT_MASTER_DATA_DIR/reference-library/{subway,road}/ 아래 배치한다.
# 컨테이너 경로 예: /opt/ddubi/transit-master/reference-library/subway/manifest.json
DDUBI_REFERENCE_PACKAGES_SUBWAY_PATH=
DDUBI_REFERENCE_PACKAGES_SUBWAY_SHA256=
DDUBI_REFERENCE_PACKAGES_ROAD_PATH=
DDUBI_REFERENCE_PACKAGES_ROAD_SHA256=
# 서울 지하철 마스터 적재(기존). 검증된 공식 파일을 준비하기 전에는 false를 유지한다.
DDUBI_TRANSIT_MASTER_IMPORT_ENABLED=false
DDUBI_TRANSIT_MASTER_DATA_VERSION=
DDUBI_TRANSIT_MASTER_BUS_WORKBOOK=/opt/ddubi/transit-master/seoul-bus-routes.xlsx
DDUBI_TRANSIT_MASTER_SUBWAY_TIMETABLE=/opt/ddubi/transit-master/seoul-subway-timetable.csv
DDUBI_TRANSIT_MASTER_SUBWAY_REALTIME_STATIONS=
DDUBI_TRANSIT_MASTER_ALIASES=

# =====================================================================
# 수집기(collector) 전용 — 컨테이너 하나가 API 하나(총 9개). 키 변수는 <소스명>_API_KEY (2026-09-10 통일)
# 버스 대응표(BUS_CROSSWALK_PATH / BUS_CROSSWALK_SHA256)는 compose 기본값으로 저장소 파일을 가리키므로 보통 비워 둔다.
# 파일을 새로 만들었을 때만 여기서 덮어쓴다. 지문이 틀리면 버스 수집기와 Spark realtime 잡이 기동을 거부한다.
BUS_CROSSWALK_PATH=
BUS_CROSSWALK_SHA256=
# 값은 서버1 .env 에만 넣는다. 같은 실제 키를 여러 변수에 넣어도 되지만 호출 예산은 키 값 기준으로 합산된다
# =====================================================================
# 주기(초)를 비우면 소스별 기본값(weather 600, bus 28800, subway_arrival 360, subway_location 3600, alert·incident·notice 900, city 21600)
COLLECTOR_INTERVAL_SECONDS=
# 날씨: 기상청 API 허브 인증키(우선). 없으면 공공데이터포털 키(디코딩된 값)로 초단기실황 조회
KMA_API_KEY=
DATA_GO_KR_API_KEY=
# 버스 도착 / 버스 위치 (공공데이터포털)
BUS_ARRIVAL_API_KEY=
BUS_LOCATION_API_KEY=
# 지하철 도착·위치 / 지하철 알림 (서울 열린데이터광장)
SUBWAY_API_KEY=
SUBWAY_ALERT_API_KEY=
# 실시간 도시데이터 121장소 / TOPIS 공지 / 교통 돌발 (서울 열린데이터광장)
CITY_REALTIME_API_KEY=
TOPIS_NOTICE_API_KEY=
TRAFFIC_INCIDENT_API_KEY=
# 호출 예산: 실제 키 값이 같은 변수끼리 합산해 최근 24시간 이 횟수까지 (1~1000)
API_DAILY_LIMIT=900
# 수집 범위 — 비우면 코드 안 기본값(버스 노선 config/bus_route_ids.json 상위 BUS_ROUTE_LIMIT 개, 도시 121장소 config/city_areas.json, 날씨 서울 25개 구)
WEATHER_GRID_POINTS=
BUS_WEATHER_MAPPING_TTL_SECONDS=2592000
BUS_ROAD_MAPPING_TTL_SECONDS=2592000
BUS_CITY_MAPPING_TTL_SECONDS=2592000
CITY_MAPPING_MAX_DISTANCE_METERS=300
CITY_MAPPING_AMBIGUITY_METERS=50
BUS_ROUTE_IDS=
BUS_ROUTE_LIMIT=100
SUBWAY_LINES=
# 위치·도착만 KST 03:30~04:30 호출 생략. 특별 운행일은 실제 새벽 날짜로 해제.
SUBWAY_SKIP_ENABLED=true
SUBWAY_SKIP_START=03:30
SUBWAY_SKIP_END=04:30
SUBWAY_SKIP_OVERRIDE_DATES=
CITY_AREA_IDENTIFIERS=
CITY_AREA_REGISTRY_PATH=

# backend 가 쓰는 외부 API 키 (경로 후보용 카카오맵)
KAKAO_REST_API_KEY=

# TOPIS 공지 AI 구조화. 키는 비워 두고 서버 infra/.env에서만 설정한다.
# GMS 키는 여기 한 곳에만 둔다 — 위쪽에 같은 이름이 하나 더 있어서, 위를 채워도
# 아래 빈 값이 이기는 상태였다(2026-09-18 정리).
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/
GMS_MODEL=gpt-4o-mini
# Backend 사용자 추천 카드 문장화. 키는 위 GMS_API_KEY를 공유하고 모델만 별도로 선택한다.
DDUBI_RECOMMENDATION_GUIDE_ENABLED=true
GMS_RECOMMENDATION_MODEL=gpt-5.4-nano
TOPIS_AI_TIMEOUT_SECONDS=30
# 비우면 Redis만 사용한다. HDFS Silver를 켤 서버에서만 경로를 설정한다.
TOPIS_SILVER_OUTPUT_URI=

# 교통 돌발 Silver. 공식 OA-13310 동일 ID 검증·승인 artifact가 없으면 링크 자동 매핑은 비활성화된다.
TRAFFIC_INCIDENT_SILVER_OUTPUT_URI=
TRAFFIC_LINK_MASTER_PATH=
TRAFFIC_LINK_MASTER_SHA256=
TRAFFIC_INCIDENT_STALE_SECONDS=2700
TRAFFIC_LINK_COORD_TOLERANCE_METERS=200
TRAFFIC_NEARBY_MAX_METERS=100

# -------------------------------------------------------------------------
# backend 전용 — 비어 있으면 그 기능만 조용히 죽는다(기동은 된다)
# 값 이름은 backend/src/main/resources/application.yml 이 읽는 이름과 정확히 같아야 한다
# -------------------------------------------------------------------------
# 소셜 로그인 — 이 파일(서버 infra/.env)에서 관리한다. PM 담당
KAKAO_APP_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- 아래는 이 파일이 아니라 GitLab CI/CD 변수로 관리한다 ----
# 배포 잡(deploy-server2)이 .env.backend 를 따로 만들어 주므로 여기에 적지 않는다.
# 여기에도 적으면 compose 의 environment 가 env_file 보다 우선이라 오히려 덮어쓴다.
#
#   MAIL_USERNAME  MAIL_PASSWORD        (이메일 인증. Gmail 앱 비밀번호)
#   FIREBASE_CREDENTIALS_BASE64        (FCM 서비스 계정 키. base64 -w0 로 만든다)

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# 비워 두면 compose 가 시작을 거부한다. Grafana 는 알림 규칙과 웹훅을 다루는 관리자 화면이라 기본 비밀번호로 두면 안 된다.
GRAFANA_ADMIN_PASSWORD=
# Grafana 알림을 보낼 Mattermost 수신 웹훅 URL (채널 → 통합 → Incoming Webhooks). 아는 사람은 그 채널에 글을 쓸 수 있는 비밀값 — 서버 .env 에만
GRAFANA_ALERT_WEBHOOK_URL=

# 이미지 버전 (latest 금지, 동작 확인 후 고정)
KAFKA_VERSION=3.9.1
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui
KAFKA_UI_VERSION=v1.1.0
MYSQL_VERSION=8.4
REDIS_VERSION=7.4-alpine
SPARK_VERSION=3.5.3-python3
HADOOP_VERSION=3.4.1
PROMETHEUS_VERSION=v2.55.1
GRAFANA_VERSION=11.3.1
KAFKA_EXPORTER_VERSION=v1.8.0
NODE_EXPORTER_VERSION=v1.8.2
NGINX_VERSION=1.27-alpine
CERTBOT_VERSION=v2.11.0
JSON_EXPORTER_VERSION=v0.7.0
BLACKBOX_EXPORTER_VERSION=v0.25.0
REDIS_EXPORTER_VERSION=v1.66.0
MYSQLD_EXPORTER_VERSION=v0.16.0

# 서버 배포 시에만 설정
SERVER1_PRIVATE_IP=
SERVER2_PRIVATE_IP=
PUBLIC_DOMAIN=
# 평소에는 비워 둔다. 서버1 네임노드를 잃어 서버2의 예비 네임노드로 이어받았을 때만 scripts/failover-namenode.sh 가
# 서버2 사설 IP 를 여기에 써 넣는다. 서버1을 복구한 뒤에는 다시 지운다. 절차는 docs/runbooks/hdfs-namenode-metadata-loss.md 에 있다.
HDFS_NAMENODE_HOST=
TLS_EMAIL=
