    {
      "id": 108,
      "type": "timeseries",
      "title": "backend 요청 (건/초)와 5xx",
      "description": "nginx 를 거쳐 backend 에 닿은 요청. 5xx 가 0 이 아니면 backend 로그 확인. 인증 실패(401)는 정상 응답으로 센다",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[$__rate_interval]))",
          "legendFormat": "전체",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 12
          }
        },
        "overrides": []
      }
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "backend JVM 힙 사용률",
      "description": "heap used / max. 톱니 모양(GC)이 정상. 바닥이 계속 올라가면 누수, 90% 이상 지속이면 mem_limit·Xmx 재조정",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"}) * 100",
          "legendFormat": "heap",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 12
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
