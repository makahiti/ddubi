# 로컬 실제 모델과 참조 데이터 묶음. Git에는 파일 내용을 올리지 않는다.
# 경로 미설정이면 artifacts/ml-serving/active-bundle.json의 directory를 사용한다.
# 포인터도 없으면 기존 artifacts/ml-serving/20260908-v12를 사용한다.
# 아래 경로는 예시이며 검증한 실제 설치 절대경로로 설정한다. 앱은 .env를 자동 로드하지 않는다.
# ML_BUNDLE_DIR=/absolute/path/to/verified-bundle

# 프로세스당 실행 1건 외에 허용할 대기 요청 수(0~32). 0이면 즉시 503.
ML_MAX_WAITING_REQUESTS=4
# 대기만의 최대 초(0~30). 계산 시간은 별도이며 전체 timeout은 Backend와 합의한다.
ML_QUEUE_WAIT_SECONDS=5
# 디코딩한 참조 Arrow Table의 보관 상한 MiB(0~4096). 0이면 캐시 비활성화.
# 모델·pandas 변환·요청·임시 버퍼를 포함한 컨테이너 전체 메모리 상한이 아니다.
ML_REFERENCE_CACHE_MIB=256
